# ============================================================================
# APAARSetu Production Orchestration Environment Configuration Template
# ============================================================================
# Copy this file to .env.production on your production server:
#   cp .env.production.example .env.production
# Secure permissions:
#   chmod 600 .env.production
# ============================================================================

# Database Configuration
# Option A: Self-hosted MongoDB via Docker Compose
MONGO_ROOT_USER=apaar_admin
MONGO_ROOT_PASSWORD=generate_strong_mongo_password_here

# Option B: Managed MongoDB Atlas (uncomment and replace if using Atlas)
# MONGODB_URI=mongodb+srv://app_user:strong_password@cluster0.abcde.mongodb.net/apaarsetu?retryWrites=true&w=majority

# Cryptographic Secrets (Generate using: openssl rand -base64 32)
# Both backend and frontend middleware MUST use the exact same JWT_SECRET!
JWT_SECRET=generate_strong_jwt_secret_min_32_chars_base64
AES_KEY=generate_strong_aes_key_32_bytes_base64

# Domain & Networking
DOMAIN_NAME=apaarsetu.example.com
FRONTEND_URL=https://apaarsetu.example.com
CORS_ORIGINS=https://apaarsetu.example.com
# If public browser makes direct API calls to separate subdomain:
# NEXT_PUBLIC_API_BASE_URL=https://api.apaarsetu.example.com/api/v1
# If unified through reverse proxy (recommended):
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Production Security Enforcements
SPRING_PROFILES_ACTIVE=prod
TRUST_PROXY=true
APP_BOOTSTRAP_ENABLED=false
# Only set during initial first-time database provisioning to create the super-admin:
BOOTSTRAP_ADMIN_PASSWORD=

# Rate Limiting Capacity
REQUESTS_PER_MINUTE=1000
VERIFICATION_PER_MINUTE=200

# Transactional Outbound Email Server
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your_sendgrid_api_key_or_aws_ses_smtp_password
MAIL_AUTH=true
MAIL_STARTTLS=true

