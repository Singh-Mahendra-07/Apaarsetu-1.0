# APAARSetu Next.js Frontend Production Configuration
# Public API URL used by browser clients (can be relative '/api/v1' if behind reverse proxy)
NEXT_PUBLIC_API_BASE_URL=https://api.apaarsetu.example.com/api/v1

# Internal Backend URL used by Next.js server-side rewrites (e.g. inside Docker network)
INTERNAL_BACKEND_URL=http://backend:8081/api/v1

# Cryptographic JWT Secret (MUST match the backend JWT_SECRET for middleware signature verification)
JWT_SECRET=replace-with-same-backend-jwt-secret-min-256-bits-32-chars

# Node Environment
NODE_ENV=production
