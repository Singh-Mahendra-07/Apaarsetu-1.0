# ============================================================================
# APAARSetu Backend Environment Variables Specification
# ============================================================================
# File: .env.example
#
# REASON & ARCHITECTURAL PURPOSE:
# Documents all required and optional runtime environment variables for deploying
# the APAARSetu Spring Boot backend across Development, Staging, and Production.
#
# WORKING & FUNCTIONAL FLOW:
# 1. PORT & FRONTEND_URL: Configure HTTP binding and CORS access.
# 2. MONGODB_URI: Connection string for database authentication.
# 3. JWT_SECRET & AES_KEY: Cryptographic secrets for tokens and PII encryption.
# ============================================================================

# ==============================================================================
# APAARSetu Backend Configuration Template (.env.example)
# Copy this file to .env or export these variables in your deployment environment
# ==============================================================================

# Spring Profile (Use 'prod' in production to enforce strict security checks)
SPRING_PROFILES_ACTIVE=prod

# Server Configuration
PORT=8081

# Reverse Proxy Trust Configuration (Set to 'true' behind Nginx, ALB, or Cloudflare)
TRUST_PROXY=true

# MongoDB Connection Configuration
# Supports local standalone instances, replica sets, and MongoDB Atlas clusters:
# e.g., MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/apaarsetu?retryWrites=true&w=majority
# e.g., Replica Set: mongodb://mongo1:27017,mongo2:27017/apaarsetu?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/apaarsetu

# Security & Cryptography (HS256 JWT Secret - Must be at least 256 bits, e.g. openssl rand -base64 32)
JWT_SECRET=replace-with-a-cryptographically-secure-random-256-bit-key-min-32-chars
# AES Key (256-bit key for PII encryption at rest, e.g. openssl rand -base64 32)
AES_KEY=replace-with-a-secure-random-256-bit-aes-key-min-32-chars

# CORS & Frontend Origins (Must match your production domain)
FRONTEND_URL=https://apaarsetu.example.com
CORS_ORIGINS=https://apaarsetu.example.com

# Rate Limiting
REQUESTS_PER_MINUTE=1000
VERIFICATION_PER_MINUTE=200

# Database Seeding / Bootstrap
# Set to 'false' in production environments to avoid automatic demo data initialization
APP_BOOTSTRAP_ENABLED=false
# Optional initial admin password when seeding a new database for the first time:
BOOTSTRAP_ADMIN_PASSWORD=

# Outbound Mail Server (Optional / Notifications)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=your-sendgrid-api-key
MAIL_AUTH=true
MAIL_STARTTLS=true
